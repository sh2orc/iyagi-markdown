{
  "name": "iyagi-markdown",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "description": "IYAGI Markdown — a lightweight macOS Markdown reader/editor with lossless live preview",
  "scripts": {
    "dev:frontend": "vite",
    "build:frontend": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "verify": "npm run typecheck && npm run test:unit && cargo test --workspace && cargo clippy --workspace 2>&1 | grep -E '^warning: |^error' ; test ${PIPESTATUS[0]:-0} -eq 0",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@tauri-apps/plugin-opener": "2.7.1",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "12.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/katex": "0.16.7",
    "@types/node": "22.20.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.8"
  }
}
